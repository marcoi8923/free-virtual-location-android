<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- 标题 + 状态 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:background="@drawable/badge_idle"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="未运行"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnDev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip"
            android:clickable="true"
            android:focusable="true"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="开发者"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip"
            android:layout_marginLeft="6dp"
            android:clickable="true"
            android:focusable="true"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="省电优化"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 遥测 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/card"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCoord"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="39.908700, 116.397500"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btnCopy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip"
                android:clickable="true"
                android:focusable="true"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="复制"
                android:textColor="@color/text"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="速度"
                    android:textColor="@color/text_dim"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/tvSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0 m/s"
                    android:textColor="@color/accent"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="方向"
                    android:textColor="@color/text_dim"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/tvBearing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0°"
                    android:textColor="@color/text"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="已移动"
                    android:textColor="@color/text_dim"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/tvDist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 m"
                    android:textColor="@color/text"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="时长"
                    android:textColor="@color/text_dim"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00:00"
                    android:textColor="@color/text"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 手机真实定位 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvGpsInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="真实定位：未开启"
                android:textColor="@color/blue"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnGpsUse"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="设为起点"
                android:textColor="@color/text"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 地图 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:minHeight="100dp"
        android:background="@drawable/card"
        android:clipToOutline="true">

        <com.codex.mocklocation.MapView
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|right"
            android:layout_margin="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnZoomIn"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/map_overlay_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/text"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/btnZoomOut"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginLeft="4dp"
                android:background="@drawable/map_overlay_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="−"
                android:textColor="@color/text"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/btnCenter"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginLeft="4dp"
                android:background="@drawable/map_overlay_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="◎"
                android:textColor="@color/accent"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/btnReload"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginLeft="4dp"
                android:background="@drawable/map_overlay_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="↻"
                android:textColor="@color/accent"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnMapSource"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginLeft="4dp"
                android:background="@drawable/map_overlay_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="源"
                android:textColor="@color/accent"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMapHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|left"
            android:layout_margin="6dp"
            android:padding="2dp"
            android:text="点地图即可设为目标点"
            android:textColor="@color/text_dim"
            android:textSize="10sp" />
    </FrameLayout>

    <!-- 摇杆 + 配速 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.codex.mocklocation.JoystickView
            android:id="@+id/joystick"
            android:layout_width="0dp"
            android:layout_height="190dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="190dp"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:paddingLeft="9dp"
            android:paddingRight="9dp"
            android:paddingTop="7dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/tvPace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3.0 m/s · 10.8 km/h"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPaceWalk"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="步行"
                    android:textColor="@color/text"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btnPaceRun"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_marginLeft="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="跑步"
                    android:textColor="@color/text"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btnPaceBike"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_marginLeft="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="骑行"
                    android:textColor="@color/text"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPaceCar"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="驾车"
                    android:textColor="@color/text"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btnPaceTrain"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_marginLeft="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="高铁"
                    android:textColor="@color/text"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btnPacePlane"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_marginLeft="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="飞机"
                    android:textColor="@color/text"
                    android:textSize="11sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sbPace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="50" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etPace"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/edit_bg"
                    android:hint="自定义"
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textColorHint="@color/text_dim"
                    android:textSize="12sp"
                    android:importantForAutofill="no" />

                <TextView
                    android:id="@+id/btnApplyPace"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginLeft="6dp"
                    android:background="@drawable/chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="设置"
                    android:textColor="@color/text"
                    android:textSize="12sp" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbReleaseStop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:buttonTint="@color/accent"
                android:text="松手即停（不勾选则持续移动）"
                android:textColor="@color/text_dim"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 主操作 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnToggle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="开始模拟"
            android:textColor="#FF06210F"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnGps"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/btn_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="获取定位"
            android:textColor="@color/text"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 操作胶囊：两行四列，保证所有功能一屏可见 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnOverlay"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="悬浮摇杆"
            android:textColor="@color/text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnHelp"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginLeft="5dp"
            android:layout_weight="1"
            android:background="@drawable/chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="使用说明"
            android:textColor="@color/text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnMapCenter"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginLeft="5dp"
            android:layout_weight="1"
            android:background="@drawable/chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="移到地图中心"
            android:textColor="@color/text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnFollow"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginLeft="5dp"
            android:layout_weight="1"
            android:background="@drawable/chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="跟随定位"
            android:textColor="@color/text"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnManual"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="输入坐标"
            android:textColor="@color/text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginLeft="5dp"
            android:layout_weight="1"
            android:background="@drawable/chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="收藏此点"
            android:textColor="@color/text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnFav"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginLeft="5dp"
            android:layout_weight="1"
            android:background="@drawable/chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="收藏夹"
            android:textColor="@color/text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnTrail"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginLeft="5dp"
            android:layout_weight="1"
            android:background="@drawable/chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="清空轨迹"
            android:textColor="@color/text"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="首次使用：开发者选项 → 选择模拟位置信息应用 → 选「模拟定位」，再点开始。"
        android:textColor="@color/text_dim"
        android:textSize="11sp" />
</LinearLayout>
