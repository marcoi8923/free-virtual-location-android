<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ovRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/overlay_panel"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/ovDragArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/overlay_handle"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="4dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⠿"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/ovSpeed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="0.00 m/s"
            android:textColor="@color/accent"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/ovClose"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/overlay_close"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="×"
            android:textColor="@color/text"
            android:textSize="14sp" />
    </LinearLayout>

    <com.codex.mocklocation.JoystickView
        android:id="@+id/ovJoystick"
        android:layout_width="164dp"
        android:layout_height="164dp"
        android:layout_marginTop="4dp" />
</LinearLayout>
